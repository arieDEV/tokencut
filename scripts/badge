#!/usr/bin/env python3
"""User-visible tokencut badges (single role or multi-step chain)."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

MODEL_EMOJI = {"low": "💚", "medium": "💛", "high": "❤️"}
ROLE_EMOJI = {
    "reader": "📖",
    "writer": "✍️",
    "reviewer": "🔎",
    "architect": "🏗️",
    "debugger": "🐛",
    "synthesizer": "🧵",
}


def badge_enabled() -> bool:
    sp = Path("/workspace/tokencut/config/settings.json")
    if not sp.is_file():
        return True
    try:
        return json.loads(sp.read_text()).get("badge", True) is not False
    except Exception:
        return True


def fmt_step(role: str, model: str) -> str:
    return f"{ROLE_EMOJI.get(role, '✂️')}{role}{MODEL_EMOJI.get(model, '⚪')}"


def badge_tokencut(*, role: str, model: str, job_id: str | None = None, saved_pct: float | None = None) -> str:
    parts = [f"✂️ tokencut {fmt_step(role, model)}", f"model={model}"]
    if job_id:
        parts.append(f"job={job_id}")
    if saved_pct is not None:
        parts.append(f"hemat≈{saved_pct:.0f}% konteks utama")
    return " · ".join(parts)


def badge_chain(steps: list[tuple[str, str]], *, job_id: str | None = None) -> str:
    chain = "→".join(fmt_step(r, m) for r, m in steps)
    parts = [f"✂️ tokencut chain {chain}"]
    if job_id:
        parts.append(f"job={job_id}")
    return " · ".join(parts)


def badge_main() -> str:
    return "🧠 main · tanpa tokencut · model=chat-utama"


def parse_chain(s: str) -> list[tuple[str, str]]:
    # writer:low,reviewer:medium,synthesizer:high
    out = []
    for part in s.split(","):
        part = part.strip()
        if not part:
            continue
        if ":" not in part:
            raise SystemExit(f"Bad chain step '{part}' (want role:model)")
        role, model = part.split(":", 1)
        out.append((role.strip(), model.strip()))
    if not out:
        raise SystemExit("Empty --chain")
    return out


def main() -> int:
    ap = argparse.ArgumentParser(description="Emit tokencut visibility badge")
    ap.add_argument("--from-job", help="Path to job manifest.json")
    ap.add_argument("--role")
    ap.add_argument("--model")
    ap.add_argument("--job-id")
    ap.add_argument("--saved-approx", type=float)
    ap.add_argument("--chain", help="Comma steps role:model,role:model,...")
    ap.add_argument("--from-chain-json", help="Path to chain.json written by pipeline")
    ap.add_argument("--none", action="store_true")
    args = ap.parse_args()

    if args.none:
        print(badge_main())
        return 0

    if not badge_enabled():
        print("🧠 main · badge=OFF")
        return 0

    if args.chain:
        print(badge_chain(parse_chain(args.chain), job_id=args.job_id))
        return 0

    if args.from_chain_json:
        data = json.loads(Path(args.from_chain_json).read_text())
        steps = data.get("steps") or []
        # steps may be role names only — look up model from roles.json
        roles = json.loads(Path("/workspace/tokencut/config/roles.json").read_text())["roles"]
        parsed = []
        for s in steps:
            if isinstance(s, str):
                parsed.append((s, roles.get(s, {}).get("model_hint", "low")))
            elif isinstance(s, dict):
                parsed.append((s["role"], s.get("model_hint") or s.get("model") or "low"))
        print(badge_chain(parsed, job_id=args.job_id or data.get("job_id")))
        return 0

    role, model, job_id = args.role, args.model, args.job_id
    if args.from_job:
        data = json.loads(Path(args.from_job).read_text())
        role = role or data.get("role") or str(data.get("mode") or "").removeprefix("role-")
        model = model or data.get("model_hint") or data.get("effort")
        job_id = job_id or data.get("job_id")

    if not role or not model:
        print("Error: need --from-job / --chain / --role+--model / --none", file=sys.stderr)
        return 2

    print(badge_tokencut(role=role, model=model, job_id=job_id, saved_pct=args.saved_approx))
    return 0


if __name__ == "__main__":
    sys.exit(main())
