#!/usr/bin/env bash
# Pack a boilerplate code-write job for a low-cost executor (no Portal / AiKA).
# Usage: code-write --spec "..." --reference ref.ts [--target out.ts]
#
# Prints a JSON job manifest on stdout. Agent Tasks an executor (model=low)
# with prompt_file. Worker writes --target if provided.

set -euo pipefail
# shellcheck source=lib/delegate.sh
. "$(cd "$(dirname "$0")" && pwd)/lib/delegate.sh"

spec=""
reference=""
target=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --spec)      spec="$2"; shift 2 ;;
    --reference) reference="$2"; shift 2 ;;
    --target)    target="$2"; shift 2 ;;
    -h|--help)
      echo "Usage: code-write --spec \"...\" --reference <file> [--target <file>]"
      exit 0
      ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [[ -z "$spec" ]]; then
  echo "Error: --spec is required" >&2
  exit 1
fi
if [[ -z "$reference" ]]; then
  echo "Error: --reference is required — pass a file whose patterns the output should match." >&2
  exit 1
fi

if [[ "$reference" != /* ]]; then
  reference="$(cd "$(dirname "$reference")" && pwd)/$(basename "$reference")"
fi
if [[ -n "$target" && "$target" != /* ]]; then
  target="$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"
fi

shunt_local_preflight || exit 1
shunt_local_check_readable "$reference" || exit 1

shunt_local_new_job code-writer

{
  cat <<'HDR'
# Boilerplate code write (shunt-local)

You are a low-cost worker. Generate code that matches the reference file's patterns, naming, and style. Read the reference with the Read tool. Output only code — no explanations, no markdown fences unless the spec asks for them.

If a target path is given, write the file there and report: path, line count, and a 3-bullet summary of what you wrote. If no target, print the full code to your final message.

## Spec

HDR
  printf '%s\n\n' "$spec"
  echo "## Reference file"
  echo
  printf '`%s`\n\n' "$reference"
  if [[ -n "$target" ]]; then
    echo "## Target file (write here)"
    echo
    printf '`%s`\n\n' "$target"
  else
    echo "## Target"
    echo
    echo "None — return code in the final message only."
    echo
  fi
  echo "## Rules"
  echo
  echo "- Match the reference conventions exactly where they apply."
  echo "- If the spec is ambiguous, choose the option closest to the reference."
  echo "- Do not invent dependencies that the reference does not use."
} > "$PROMPT_FILE"

printf '%s\n' "$reference" > "${JOB_DIR}/reference.txt"
[[ -n "$target" ]] && printf '%s\n' "$target" > "${JOB_DIR}/target.txt"

shunt_local_emit_job code-writer "code-write: ref=$(basename "$reference")${target:+ → $(basename "$target")}"
