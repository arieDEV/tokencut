#!/usr/bin/env bash
# Pack / describe tokencut pipelines (agent still runs each step).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROLES="$ROOT/config/roles.json"
# shellcheck source=lib/delegate.sh
. "$(cd "$(dirname "$0")" && pwd)/lib/delegate.sh"
TOKENCUT_ROLES_FILE="$ROLES"

cmd_list() {
  jq -r '.pipelines | to_entries[] | "\(.key)\t\(.value.description)\tsteps=\(.value.steps|join("→"))"' "$ROLES"
}

name=""
spec=""
reference=""
target=""
question=""
paths=()
brief=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --list) cmd_list; exit 0 ;;
    --show)
      jq --arg n "$2" '.pipelines[$n] // empty' "$ROLES"
      exit 0
      ;;
    --pack) name="$2"; shift 2 ;;
    --spec) spec="$2"; shift 2 ;;
    --reference) reference="$2"; shift 2 ;;
    --target) target="$2"; shift 2 ;;
    --question) question="$2"; shift 2 ;;
    --brief) brief="$2"; shift 2 ;;
    --paths)
      shift
      while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do paths+=("$1"); shift; done
      ;;
    -h|--help)
      sed -n '2,8p' "$0" | tr -d '#'
      exit 0
      ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

[[ -n "$name" ]] || { echo "Error: --pack <pipeline> required (or --list/--show)" >&2; exit 1; }
jq -e --arg n "$name" '.pipelines[$n]' "$ROLES" >/dev/null || {
  echo "Error: unknown pipeline '$name'" >&2; cmd_list >&2; exit 1; }

chain=$(jq -r --arg n "$name" '.pipelines[$n].steps|join("→")' "$ROLES")

write_chain_file() {
  local job_dir="$1"
  jq -n --arg n "$name" --argjson steps "$(jq -c --arg n "$name" '.pipelines[$n].steps' "$ROLES")" \
    '{pipeline:$n, steps:$steps, badge_hint:("✂️ tokencut chain "+($steps|join("→")))}' \
    > "${job_dir}/chain.json"
}

case "$name" in
  draft-then-review)
    [[ -n "$spec" && -n "$reference" ]] || {
      echo "Error: draft-then-review needs --spec and --reference [--target]" >&2; exit 1; }
    args=(--role writer --spec "$spec" --reference "$reference")
    [[ -n "$target" ]] && args+=(--target "$target")
    json=$("$ROOT/scripts/role-run" "${args[@]}")
    echo "$json"
    job_dir=$(echo "$json" | jq -r .job_dir)
    write_chain_file "$job_dir"
    cat > "${job_dir}/PIPELINE.md" << PLAN
# AUTO-CONTINUE: finish all steps without asking the user to type lanjut.
# Pipeline: (AUTO-CONTINUE — agent must finish all steps without waiting for user)
# Pipeline: draft-then-review ($chain)

1. Run writer (model=low) using prompt_file above.
2. Pack reviewer:
   $ROOT/scripts/role-run --role reviewer \\
     --question "Review the draft for bugs, risks, and missing tests." \\
     --paths ${target:-$reference} \\
     ${target:+--draft $target}
   Run reviewer (model=medium).
3. Save writer+reviewer outputs to ${job_dir}/worker-outputs.md
4. Pack synthesizer (required):
   $ROOT/scripts/role-run --role synthesizer \\
     --question "Merge writer and reviewer outputs into one final answer for the user (id-ID if they wrote in Indonesian)." \\
     --brief ${job_dir}/worker-outputs.md
   Run synthesizer (model=high).
5. Reply to user with synthesizer answer + badge chain:
   \`$ROOT/scripts/badge --chain writer:low,reviewer:medium,synthesizer:high --job-id <final_job_id>\`
PLAN
    echo "[tokencut: pipeline $name → ${job_dir}/PIPELINE.md]" >&2
    ;;
  read-then-architect|read-then-synthesize)
    [[ -n "$question" && ${#paths[@]} -gt 0 ]] || {
      echo "Error: $name needs --question and --paths" >&2; exit 1; }
    json=$("$ROOT/scripts/role-run" --role reader --question "$question" --paths "${paths[@]}")
    echo "$json"
    job_dir=$(echo "$json" | jq -r .job_dir)
    write_chain_file "$job_dir"
    if [[ "$name" == "read-then-architect" ]]; then
      cat > "${job_dir}/PIPELINE.md" << PLAN
# AUTO-CONTINUE: finish all steps without asking the user to type lanjut.
# Pipeline: (AUTO-CONTINUE — agent must finish all steps without waiting for user)
# Pipeline: read-then-architect ($chain)

1. Run reader (model=low). Save answer to ${job_dir}/brief.md
2. Pack architect:
   $ROOT/scripts/role-run --role architect --question "$question" --brief ${job_dir}/brief.md
   Run architect (model=high). Append output to ${job_dir}/worker-outputs.md
3. Pack synthesizer:
   $ROOT/scripts/role-run --role synthesizer \\
     --question "Produce the final user-facing recommendation from the brief+architect notes." \\
     --brief ${job_dir}/worker-outputs.md
   Run synthesizer (model=high).
4. Badge: \`$ROOT/scripts/badge --chain reader:low,architect:high,synthesizer:high --job-id <final_job_id>\`
PLAN
    else
      cat > "${job_dir}/PIPELINE.md" << PLAN
# AUTO-CONTINUE: finish all steps without asking the user to type lanjut.
# Pipeline: (AUTO-CONTINUE — agent must finish all steps without waiting for user)
# Pipeline: read-then-synthesize ($chain)

1. Run reader (model=low). Save answer to ${job_dir}/brief.md
2. Pack synthesizer:
   $ROOT/scripts/role-run --role synthesizer --question "$question" --brief ${job_dir}/brief.md
   Run synthesizer (model=high).
3. Badge: \`$ROOT/scripts/badge --chain reader:low,synthesizer:high --job-id <final_job_id>\`
PLAN
    fi
    echo "[tokencut: pipeline $name → ${job_dir}/PIPELINE.md]" >&2
    ;;
  *)
    echo "Error: packer not implemented for $name" >&2
    exit 1
    ;;
esac
