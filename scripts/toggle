#!/usr/bin/env bash
# tokencut on/off switch
# Usage:
#   toggle          # status
#   toggle status
#   toggle on
#   toggle off
#   toggle badge on|off
#   toggle smart-route on|off

set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SETTINGS="$ROOT/config/settings.json"
# shellcheck source=lib/delegate.sh
. "$ROOT/scripts/lib/delegate.sh"
TOKENCUT_ROOT="$ROOT"
TOKENCUT_SETTINGS_FILE="$SETTINGS"

ensure_settings() {
  if [[ ! -f "$SETTINGS" ]]; then
    mkdir -p "$(dirname "$SETTINGS")"
    printf '%s\n' '{"enabled":true,"badge":true,"smart_route":true,"updated_at":null,"updated_by":null}' > "$SETTINGS"
  fi
}

set_key() {
  local key="$1" val="$2"
  ensure_settings
  local tmp
  tmp=$(mktemp)
  jq --arg k "$key" --argjson v "$val" --arg ts "$(date -Iseconds)" \
    '.[$k]=$v | .updated_at=$ts | .updated_by="toggle"' "$SETTINGS" > "$tmp"
  mv "$tmp" "$SETTINGS"
}

print_status() {
  ensure_settings
  local en badge sr
  en=$(jq -r .enabled "$SETTINGS")
  badge=$(jq -r .badge "$SETTINGS")
  sr=$(jq -r .smart_route "$SETTINGS")
  local en_l badge_l sr_l
  [[ "$en" == "true" ]] && en_l="ON 🟢" || en_l="OFF 🔴"
  [[ "$badge" == "true" ]] && badge_l="ON" || badge_l="OFF"
  [[ "$sr" == "true" ]] && sr_l="ON" || sr_l="OFF"
  echo "tokencut:        $en_l"
  echo "badge:           $badge_l"
  echo "smart-route:     $sr_l"
  echo "settings_file:   $SETTINGS"
  jq -c '{enabled,badge,smart_route,updated_at}' "$SETTINGS"
}

cmd="${1:-status}"
case "$cmd" in
  status|s)
    print_status
    ;;
  on)
    set_key enabled true
    echo "tokencut ON 🟢"
    print_status
    ;;
  off)
    set_key enabled false
    echo "tokencut OFF 🔴 — agent should answer on main chat only"
    print_status
    ;;
  badge)
    case "${2:-}" in
      on) set_key badge true; echo "badge ON" ;;
      off) set_key badge false; echo "badge OFF" ;;
      *) echo "Usage: toggle badge on|off" >&2; exit 2 ;;
    esac
    print_status
    ;;
  smart-route|smart_route)
    case "${2:-}" in
      on) set_key smart_route true; echo "smart-route ON" ;;
      off) set_key smart_route false; echo "smart-route OFF" ;;
      *) echo "Usage: toggle smart-route on|off" >&2; exit 2 ;;
    esac
    print_status
    ;;
  -h|--help|help)
    sed -n '2,10p' "$0" | sed 's/^# //'
    ;;
  *)
    echo "Unknown: $cmd (use on|off|status|badge|smart-route)" >&2
    exit 2
    ;;
esac
